{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'skipping build'",
  "outputDirectory": "laravel/public",
  "builds": [
    {
      "src": "laravel/Dockerfile.vercel",
      "use": "@vercel/docker"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/laravel/server.php" }
  ]
}
