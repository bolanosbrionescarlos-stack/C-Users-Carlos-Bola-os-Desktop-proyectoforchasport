# Configuración para producción (Vercel)
APP_NAME="Forcha Sport"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# Base de datos - Recomendado usar externa (Neon, Supabase, PlanetScale, etc.)
# SQLite fallback (demo-only, se copia a /tmp en Dockerfile.vercel)
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/forchasport/database.sqlite

# Session y cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Correo (opcional)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@forchasport.com"
MAIL_FROM_NAME="${APP_NAME}"

# Almacenamiento de archivos
# Para producción, considera usar S3/Cloudinary/R2 para persistir imágenes entre despliegues
FILESYSTEM_DISK=public

# Seguridad
BCRYPT_ROUNDS=12
